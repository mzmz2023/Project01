# ============================================================
# 电影推荐系统 — 环境配置
# 此文件作为团队统一的配置参考，docker-compose 及各服务由此取值
# ============================================================

# ---------------------------
# 后端服务 (FastAPI)
# ---------------------------
API_HOST=0.0.0.0
API_PORT=8000
PYTHONPATH=/app

# 数据库
DATABASE_URL=sqlite:///db/recommend.db

# ---------------------------
# 前端服务 (Vite + React)
# 注意：Vite 在构建时会将 VITE_ 前缀的变量编译进静态文件，
#       docker-compose 运行时注入同名变量确保生产环境可用
# ---------------------------
VITE_DEV_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
